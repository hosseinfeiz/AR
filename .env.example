# Admin login (server-only)
# Generate the hash with: node -e "console.log(require('crypto').createHash('sha256').update('YOUR-PASSWORD').digest('hex'))"
# If unset, falls back to admin/admin in dev only — production MUST set both.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SHA256=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918

# Shared secret for the DB → Edge Function webhook (notify-on-new-request).
# Generate with: openssl rand -hex 32
NOTIFY_WEBHOOK_SECRET=__generate_a_random_hex_string__

# Supabase (public)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=__from_supabase_start__

# Supabase (server-only — Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=__from_supabase_start__

# Resend (server-only)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=hello@ar-management.example
# Shared secret for the Resend webhook handler. Set to a long random string
# and configure the same value as the `x-resend-secret` header in Resend.
# If unset, the webhook accepts all requests (dev mode only).
RESEND_WEBHOOK_SECRET=

# Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=0x4AAA__site
TURNSTILE_SECRET_KEY=0x4AAA__secret

# Sentry (public DSN OK in client, but split per platform later)
VITE_SENTRY_DSN=https://...@sentry.io/123

# Notification fan-out
EMERGENCY_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Stripe (S1 — rent collection)
# Server-side secret key. Use sk_test_... in dev, sk_live_... in production.
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret from the Stripe dashboard endpoint config.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Public publishable key — safe to expose to the browser.
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Lease Q&A (S3) — RAG via pgvector + Claude
# OpenAI is used ONLY for embeddings (text-embedding-3-large @ 1536 dims).
OPENAI_API_KEY=sk-proj-xxx
# Anthropic is used for answer generation (claude-sonnet-4-6).
ANTHROPIC_API_KEY=sk-ant-xxx

# Tenant screening — TransUnion SmartMove (S2 applicant pipeline)
# Leave unset to use the deterministic mock screening provider.
SMARTMOVE_API_KEY=sm_test_xxx

# E-signature — Dropbox Sign (S2 applicant pipeline)
# Leave unset to use the mock envelope flow + in-app lease preview.
DROPBOX_SIGN_API_KEY=hs_test_xxx
DROPBOX_SIGN_TEAM_ID=
