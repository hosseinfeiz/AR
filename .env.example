# Stripe (S1 — rent collection)
# Server-side secret key. Use sk_test_... in dev, sk_live_... in production.
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret from the Stripe dashboard endpoint config.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Public publishable key — safe to expose to the browser.
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Lease Q&A (S3) — RAG via pgvector + Claude
# OpenAI is used ONLY for embeddings (text-embedding-3-large @ 1536 dims).
OPENAI_API_KEY=sk-proj-xxx
# Anthropic is used for answer generation (claude-sonnet-4-6).
ANTHROPIC_API_KEY=sk-ant-xxx

# Tenant screening — TransUnion SmartMove (S2 applicant pipeline)
# Leave unset to use the deterministic mock screening provider.
SMARTMOVE_API_KEY=sm_test_xxx

# E-signature — Dropbox Sign (S2 applicant pipeline)
# Leave unset to use the mock envelope flow + in-app lease preview.
DROPBOX_SIGN_API_KEY=hs_test_xxx
DROPBOX_SIGN_TEAM_ID=

# Mapbox (public) — required only for the listings "Map view" toggle.
# When unset, the map renders a clear "operator needs to set PUBLIC_MAPBOX_TOKEN" notice.
PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoi__public_mapbox_token__

# Web Push (S9 PWA) — generate via:  npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: URL or HTTPS URL identifying the sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@ar-management.example
# Also expose the public key to the browser (used by PushOptInButton):
PUBLIC_VAPID_PUBLIC_KEY=

# Rentometer (S10 AI helpers) — server-only. When unset, the API falls back
# to a clearly-labeled ±15% mock estimate so the UI keeps working in dev.
# ANTHROPIC_API_KEY (used by S10 too) is already declared above for S3.
RENTOMETER_API_KEY=

# Google Calendar OAuth (S4 — per-manager refresh tokens stored in DB)
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_OAUTH_REDIRECT_URI=https://ar-management.example/api/oauth/google-calendar/callback

# Twilio (S4 SMS reminders — optional; if AUTH_TOKEN unset, SMS step is skipped + logged)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15555550100

# Reschedule token HMAC secret (S4) — generate with: openssl rand -hex 32
RESCHEDULE_SECRET=replace-with-a-32-byte-hex-string

# Vendor portal (S6) — HMAC secret used to sign tokens for /vendor/[token]
# and /maintenance-survey/[token] links. Rotate to invalidate outstanding links.
VENDOR_PORTAL_SECRET=change-me-to-a-random-32-byte-hex-string
