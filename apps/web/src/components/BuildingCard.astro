---
import { FavoritesButton } from './islands/FavoritesButton'

interface Props {
  b: { id: string; slug: string; name: string; address_line1: string; city: string; state: string }
  showFavorite?: boolean
}
const { b, showFavorite = true } = Astro.props
---
<div
  class="relative"
  data-building-id={b.id}
  data-building-slug={b.slug}
  data-building-name={b.name}
>
  <a
    href={`/buildings/${b.slug}`}
    class="block border border-gray-200 rounded-xl p-5 pr-14 hover:border-[var(--color-brand)] transition"
  >
    <h3 class="text-lg font-semibold">{b.name}</h3>
    <p class="text-gray-600 text-sm mt-1">{b.address_line1}, {b.city}, {b.state}</p>
  </a>
  {showFavorite && (
    <div class="absolute top-3 right-3">
      <FavoritesButton client:load id={b.id} kind="building" />
    </div>
  )}
</div>
