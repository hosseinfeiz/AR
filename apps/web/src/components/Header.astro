---
import { getSession } from '../lib/auth'
import { LogoutButton } from './islands/LogoutButton'
import ThemeToggle from './ThemeToggle.astro'

const session = getSession(Astro.cookies)

const links = [
  { href: '/listings', label: 'Listings' },
  { href: '/maintenance', label: 'Maintenance' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
]
---
<header class="border-b border-gray-200 bg-white sticky top-0 z-10">
  <nav class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight">A &amp; R Management</a>
    <ul class="hidden sm:flex gap-6 text-sm">
      {links.map((l) => (
        <li><a href={l.href} class="text-gray-700 hover:text-[var(--color-brand)]">{l.label}</a></li>
      ))}
    </ul>
    <div class="hidden sm:flex items-center gap-3">
      <ThemeToggle />
      {session === null && (
        <>
          <a href="/login" class="text-sm text-gray-600 hover:text-gray-900">Sign in</a>
          <a href="/schedule" class="inline-flex bg-[var(--color-brand)] text-white px-3 py-1.5 rounded text-sm font-medium hover:bg-[var(--color-brand-dark)]">Schedule a showing</a>
        </>
      )}
      {session?.type === 'admin' && (
        <>
          <a href="/admin" class="text-sm font-medium text-gray-700 hover:text-[var(--color-brand)]">Admin</a>
          <LogoutButton client:load className="text-sm text-gray-600 hover:text-gray-900" />
        </>
      )}
      {session?.type === 'tenant' && (
        <>
          <a href="/portal" class="text-sm font-medium text-gray-700 hover:text-[var(--color-brand)]">My Portal</a>
          <LogoutButton client:load className="text-sm text-gray-600 hover:text-gray-900" />
        </>
      )}
    </div>
  </nav>
</header>
