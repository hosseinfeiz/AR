---
import Badge from './primitives/Badge.astro'
interface Props { amenities: string[] }
const { amenities } = Astro.props
---
{amenities.length === 0 ? null : (
  <ul class="flex flex-wrap gap-2">
    {amenities.map((a) => (
      <li><Badge tone="neutral" size="sm">{a}</Badge></li>
    ))}
  </ul>
)}
