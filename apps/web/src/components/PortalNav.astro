---
interface Props {
  active: 'overview' | 'payments' | 'maintenance' | 'messages' | 'lease-qa'
}

const { active } = Astro.props

const links = [
  { href: '/portal', label: 'Overview', key: 'overview' },
  { href: '/portal/payments', label: 'Payments', key: 'payments' },
  { href: '/portal/maintenance', label: 'Maintenance', key: 'maintenance' },
  { href: '/portal/messages', label: 'Messages', key: 'messages' },
  { href: '/portal/lease-qa', label: 'Lease Q&A', key: 'lease-qa' },
]
---
<nav class="border-b border-gray-200 bg-white sticky top-[53px] z-10">
  <div class="max-w-5xl mx-auto px-4">
    <ul class="flex gap-1 overflow-x-auto">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class={`inline-block px-4 py-3 text-sm font-medium border-b-2 transition whitespace-nowrap ${
              active === l.key
                ? 'border-[var(--color-brand)] text-[var(--color-brand)]'
                : 'border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300'
            }`}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
