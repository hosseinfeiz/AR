---
export const prerender = false
import Base from '../../layouts/Base.astro'
import { verifyToken, getSurveyForRequest } from '../../lib/vendors'
import { tenantRequests, tenants, type Tenant, type TenantMaintenanceRequest } from '../../lib/tenant-fixtures'

const token = Astro.params.token ?? ''
const payload = await verifyToken(token)

let request_: TenantMaintenanceRequest | null = null
let tenant: Tenant | null = null
let alreadySubmitted = false

if (payload && payload.kind === 'sv') {
  request_ = tenantRequests.find((r) => r.id === payload.id) ?? null
  if (request_) {
    tenant = tenants.find((t) => t.id === request_!.tenant_id) ?? null
    alreadySubmitted = !!getSurveyForRequest(request_.id)
  }
}

const valid = !!payload && payload.kind === 'sv' && !!request_
---
<Base title="Maintenance feedback — A & R Management">
  <div class="max-w-xl mx-auto px-4 py-10">
    {!valid ? (
      <div class="border border-red-200 bg-red-50 rounded-xl p-6">
        <h1 class="text-xl font-bold text-red-900">Invalid or expired link</h1>
        <p class="text-sm text-red-800 mt-2">Survey links are sent when your request is marked resolved. If you believe this is an error, please contact your property manager.</p>
      </div>
    ) : alreadySubmitted ? (
      <div class="border border-green-200 bg-green-50 rounded-xl p-6 text-center">
        <h1 class="text-xl font-bold text-green-900">Thank you</h1>
        <p class="text-sm text-green-800 mt-2">We've already received your feedback for {request_?.ref_id}.</p>
      </div>
    ) : (
      <>
        <h1 class="text-3xl font-bold tracking-tight">How did we do?</h1>
        <p class="text-gray-500 mt-1">
          Request <span class="font-mono">{request_?.ref_id}</span>{tenant ? ` · ${tenant.name}` : ''}
        </p>

        <form
          method="POST"
          action={`/api/maintenance-survey/${encodeURIComponent(token)}/submit`}
          class="border border-gray-200 rounded-xl p-6 space-y-5 mt-6"
          enctype="application/x-www-form-urlencoded"
        >
          <fieldset>
            <legend class="text-sm font-medium text-gray-700 mb-2">Rating</legend>
            <div class="flex items-center gap-3">
              {[1, 2, 3, 4, 5].map((n) => (
                <label class="flex items-center gap-1 cursor-pointer">
                  <input type="radio" name="rating" value={n} required />
                  <span class="text-lg">{'★'.repeat(n)}<span class="text-gray-300">{'★'.repeat(5 - n)}</span></span>
                </label>
              ))}
            </div>
          </fieldset>
          <label class="block">
            <span class="text-sm font-medium text-gray-700">Comments (optional)</span>
            <textarea name="feedback" rows="4" class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" placeholder="Tell us about your experience…"></textarea>
          </label>
          <div class="flex items-center justify-end">
            <button type="submit" class="bg-[var(--color-brand)] text-white text-sm px-4 py-2 rounded-lg font-medium hover:bg-[var(--color-brand-dark)] transition">Submit feedback</button>
          </div>
        </form>
      </>
    )}
  </div>
</Base>
