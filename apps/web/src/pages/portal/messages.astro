---
export const prerender = false
import Base from '../../layouts/Base.astro'
import PortalNav from '../../components/PortalNav.astro'
import { getSession } from '../../lib/auth'
import { findTenantById, messagesForTenant } from '../../lib/tenant-fixtures'

const session = getSession(Astro.cookies)
if (!session || session.type !== 'tenant') {
  return Astro.redirect('/login?redirect=/portal/messages')
}

const tenant = findTenantById(session.tenantId)
if (!tenant) return Astro.redirect('/login')

const allMessages = messagesForTenant(tenant.id)

const selectedId = Astro.url.searchParams.get('id')
const selected = selectedId ? allMessages.find((m) => m.id === selectedId) : allMessages[0]

// Mark selected message as read (in-memory)
if (selected && !selected.read) {
  selected.read = true
}

function fmtTs(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric', month: 'short', day: 'numeric',
  })
}

const categoryColor: Record<string, string> = {
  announcement: 'bg-purple-100 text-purple-700',
  lease: 'bg-indigo-100 text-indigo-700',
  payment: 'bg-green-100 text-green-700',
  maintenance: 'bg-orange-100 text-orange-700',
  general: 'bg-gray-100 text-gray-600',
}
---
<Base title="Messages — My Portal — A & R Management">
  <PortalNav active="messages" />
  <div class="max-w-5xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold tracking-tight mb-6">Messages</h1>

    <div class="border border-gray-200 rounded-xl overflow-hidden flex" style="min-height:420px">
      <!-- List column -->
      <div class="w-72 shrink-0 border-r border-gray-200 overflow-y-auto">
        {allMessages.length === 0 ? (
          <p class="p-5 text-sm text-gray-500">No messages yet.</p>
        ) : (
          <ul class="divide-y divide-gray-100">
            {allMessages.map((m) => (
              <li>
                <a
                  href={`/portal/messages?id=${m.id}`}
                  class={`block px-4 py-3 hover:bg-gray-50 transition ${selected?.id === m.id ? 'bg-blue-50 border-l-2 border-[var(--color-brand)]' : ''}`}
                >
                  <div class="flex items-start justify-between gap-2">
                    <p class={`text-sm truncate ${m.read ? 'text-gray-600 font-normal' : 'text-gray-900 font-semibold'}`}>{m.subject}</p>
                    {!m.read && <span class="shrink-0 w-2 h-2 rounded-full bg-[var(--color-brand)] mt-1"></span>}
                  </div>
                  <p class="text-xs text-gray-500 mt-0.5">{m.from_name}</p>
                  <p class="text-xs text-gray-400 mt-0.5">{fmtTs(m.sent_at)}</p>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Detail column -->
      <div class="flex-1 p-6 overflow-y-auto">
        {selected ? (
          <div>
            <div class="mb-4">
              <div class="flex items-start justify-between gap-4">
                <h2 class="text-xl font-semibold">{selected.subject}</h2>
                <span class={`shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium capitalize ${categoryColor[selected.category] ?? 'bg-gray-100 text-gray-600'}`}>
                  {selected.category}
                </span>
              </div>
              <p class="text-sm text-gray-500 mt-1">From: {selected.from_name} · {fmtTs(selected.sent_at)}</p>
            </div>
            <div class="border-t border-gray-100 pt-4">
              <p class="text-sm text-gray-800 whitespace-pre-wrap leading-relaxed">{selected.body}</p>
            </div>
          </div>
        ) : (
          <div class="h-full flex items-center justify-center text-gray-400">
            <p>Select a message to read</p>
          </div>
        )}
      </div>
    </div>
  </div>
</Base>
