---
export const prerender = false
import Base from '../../layouts/Base.astro'
import {
  workOrderFixtures,
  vendorFixtures,
  verifyToken,
  WORK_ORDER_STATUSES,
  type WorkOrder,
  type Vendor,
} from '../../lib/vendors'
import { tenantRequests, tenants, type Tenant, type TenantMaintenanceRequest } from '../../lib/tenant-fixtures'
import { buildings, type FixtureBuilding } from '../../lib/fixtures'

const token = Astro.params.token ?? ''
const payload = await verifyToken(token)

let workOrder: WorkOrder | null = null
let vendor: Vendor | null = null
let request_: TenantMaintenanceRequest | null = null
let tenant: Tenant | null = null
let building: FixtureBuilding | null = null
let assignedOrders: WorkOrder[] = []

if (payload && payload.kind === 'wo') {
  workOrder = workOrderFixtures.find((w) => w.id === payload.id) ?? null
  if (workOrder) {
    vendor = vendorFixtures.find((v) => v.id === workOrder!.vendor_id) ?? null
    request_ = tenantRequests.find((r) => r.id === workOrder!.maintenance_request_id) ?? null
    if (request_) {
      tenant = tenants.find((t) => t.id === request_!.tenant_id) ?? null
      building = buildings.find((b) => b.id === request_!.building_id) ?? null
    }
    if (vendor) {
      assignedOrders = workOrderFixtures.filter((w) => w.vendor_id === vendor!.id && w.status !== 'billed')
    }
  }
}

const statusPill: Record<string, string> = {
  quoted: 'bg-gray-100 text-gray-700',
  scheduled: 'bg-blue-100 text-blue-800',
  in_progress: 'bg-amber-100 text-amber-800',
  completed: 'bg-green-100 text-green-800',
  billed: 'bg-slate-200 text-slate-800',
}

function fmtTs(iso: string | null) {
  if (!iso) return '—'
  return new Date(iso).toLocaleString('en-US')
}
---
<Base title="Vendor portal — A & R Management">
  <div class="max-w-3xl mx-auto px-4 py-10 space-y-6">
    {(!payload || !workOrder || !vendor) ? (
      <div class="border border-red-200 bg-red-50 rounded-xl p-6">
        <h1 class="text-xl font-bold text-red-900">Invalid or expired link</h1>
        <p class="text-sm text-red-800 mt-2">Please contact A &amp; R Management for a new dispatch link.</p>
      </div>
    ) : (
      <>
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Vendor portal</h1>
          <p class="text-gray-500 mt-1">Welcome, {vendor.name}. Update the status of your assigned jobs.</p>
        </div>

        <div class="border border-gray-200 rounded-xl p-5 bg-gray-50">
          <h2 class="font-semibold mb-2">Current dispatch</h2>
          <dl class="grid grid-cols-2 gap-y-1 gap-x-4 text-sm">
            <dt class="text-gray-500">Reference</dt><dd class="font-mono">{request_?.ref_id ?? '—'}</dd>
            <dt class="text-gray-500">Building / Unit</dt><dd>{building?.name ?? '—'} / {request_?.unit_label ?? '—'}</dd>
            <dt class="text-gray-500">Tenant</dt><dd>{tenant?.name ?? '—'}</dd>
            <dt class="text-gray-500">Tenant phone</dt><dd>{tenant?.phone ?? '—'}</dd>
            <dt class="text-gray-500">Issue</dt><dd class="capitalize">{request_?.issue_type ?? '—'} ({request_?.urgency ?? '—'})</dd>
            <dt class="text-gray-500">Description</dt><dd>{request_?.description ?? '—'}</dd>
          </dl>
        </div>

        <form
          method="POST"
          action={`/api/work-orders/${workOrder.id}/status?token=${encodeURIComponent(token)}`}
          class="border border-gray-200 rounded-xl p-6 space-y-4"
          enctype="application/x-www-form-urlencoded"
        >
          <p class="text-sm">
            Current status:
            <span class={`ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${statusPill[workOrder.status] ?? ''}`}>
              {workOrder.status.replace('_', ' ')}
            </span>
          </p>
          <label class="block">
            <span class="text-sm font-medium text-gray-700">Update status</span>
            <select class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="status">
              {WORK_ORDER_STATUSES.map((s) => (
                <option value={s} selected={s === workOrder.status}>{s.replace('_', ' ')}</option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="text-sm font-medium text-gray-700">Notes</span>
            <textarea class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" rows="3" name="notes">{workOrder.notes ?? ''}</textarea>
          </label>
          <div class="flex items-center justify-end">
            <button type="submit" class="bg-[var(--color-brand)] text-white text-sm px-4 py-2 rounded-lg font-medium hover:bg-[var(--color-brand-dark)] transition">Submit update</button>
          </div>
        </form>

        <div>
          <h2 class="font-semibold text-lg mb-3">Other open dispatches for {vendor.name}</h2>
          <div class="border border-gray-200 rounded-xl overflow-hidden">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-gray-50 border-b border-gray-200">
                  <th class="text-left px-3 py-2 font-semibold text-gray-700">Request</th>
                  <th class="text-left px-3 py-2 font-semibold text-gray-700">Status</th>
                  <th class="text-left px-3 py-2 font-semibold text-gray-700">Assigned</th>
                </tr>
              </thead>
              <tbody>
                {assignedOrders.filter((w) => w.id !== workOrder.id).length === 0 ? (
                  <tr><td colspan="3" class="px-3 py-4 text-center text-gray-500">No other open jobs.</td></tr>
                ) : assignedOrders.filter((w) => w.id !== workOrder.id).map((w) => (
                  <tr class="border-b border-gray-100">
                    <td class="px-3 py-2 font-mono text-xs">{w.maintenance_request_id}</td>
                    <td class="px-3 py-2">
                      <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${statusPill[w.status] ?? ''}`}>{w.status.replace('_', ' ')}</span>
                    </td>
                    <td class="px-3 py-2 text-gray-600">{fmtTs(w.assigned_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </>
    )}
  </div>
</Base>
