---
export const prerender = false
import Base from '../../../layouts/Base.astro'
import AdminNav from '../../../components/AdminNav.astro'
import { getSession } from '../../../lib/auth'
import {
  getVendorById,
  listWorkOrders,
  coiStatus,
  VENDOR_CATEGORIES,
  VENDOR_CATEGORY_LABELS,
} from '../../../lib/vendors'
import { buildings } from '../../../lib/fixtures'

const session = getSession(Astro.cookies)
if (!session || session.type !== 'admin') {
  return Astro.redirect('/login?redirect=/admin/vendors')
}

const id = Astro.params.id ?? ''
const vendor = await getVendorById(id)
if (!vendor) return Astro.redirect('/admin/vendors')

const today = new Date('2026-05-20T00:00:00Z')
const coi = coiStatus(vendor, today)
const orders = await listWorkOrders({ vendor_id: vendor.id })

function fmtTs(iso: string | null) {
  if (!iso) return '—'
  return new Date(iso).toLocaleString('en-US')
}

const statusPill: Record<string, string> = {
  quoted: 'bg-gray-100 text-gray-700',
  scheduled: 'bg-blue-100 text-blue-800',
  in_progress: 'bg-amber-100 text-amber-800',
  completed: 'bg-green-100 text-green-800',
  billed: 'bg-slate-200 text-slate-800',
}
---
<Base title={`${vendor.name} — Vendor — Admin`}>
  <AdminNav />
  <div class="max-w-4xl mx-auto px-4 py-10 space-y-8">
    <div>
      <p class="text-sm text-gray-500 mb-1">
        <a href="/admin" class="hover:underline">Admin</a> / <a href="/admin/vendors" class="hover:underline">Vendors</a> / {vendor.name}
      </p>
      <h1 class="text-3xl font-bold tracking-tight">{vendor.name}</h1>
      <p class="text-gray-500 mt-1">{VENDOR_CATEGORY_LABELS[vendor.category]} · {vendor.active ? 'Active' : 'Inactive'}</p>
    </div>

    <form
      method="POST"
      action={`/api/admin/vendors/${vendor.id}/update`}
      class="border border-gray-200 rounded-xl p-6 space-y-5"
      enctype="application/x-www-form-urlencoded"
    >
      <h2 class="font-semibold text-lg">Edit vendor</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label class="block">
          <span class="text-sm font-medium text-gray-700">Name</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="name" value={vendor.name} required />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700">Category</span>
          <select class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="category">
            {VENDOR_CATEGORIES.map((c) => (
              <option value={c} selected={c === vendor.category}>{VENDOR_CATEGORY_LABELS[c]}</option>
            ))}
          </select>
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700">Contact name</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="contact_name" value={vendor.contact_name ?? ''} />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700">Email</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="email" type="email" value={vendor.email ?? ''} />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700">Phone</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="phone" value={vendor.phone ?? ''} />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700">License number</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="license_number" value={vendor.license_number ?? ''} />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700">Insurance expiry date</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="insurance_expiry_date" type="date" value={vendor.insurance_expiry_date ?? ''} />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700">COI storage path</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="coi_storage_path" value={vendor.coi_storage_path ?? ''} placeholder="vendor-coi/your-vendor-2026.pdf" />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700">Rating (0–5)</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="rating" type="number" step="0.1" min="0" max="5" value={vendor.rating ?? ''} />
        </label>
        <fieldset class="block md:col-span-2">
          <legend class="text-sm font-medium text-gray-700 mb-1">Buildings</legend>
          <div class="space-y-1">
            {buildings.map((b) => (
              <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="building_ids" value={b.id} checked={vendor.building_ids.includes(b.id)} />
                {b.name}
              </label>
            ))}
          </div>
        </fieldset>
        <label class="flex items-center gap-2 md:col-span-2 text-sm">
          <input type="checkbox" name="active" value="true" checked={vendor.active} />
          <span>Active</span>
        </label>
      </div>

      <div class="flex items-center justify-between pt-2 border-t border-gray-100">
        <p class="text-xs text-gray-500">
          <span class="font-medium">COI status:</span>{' '}
          {coi.state === 'ok' && <span>OK — expires in {coi.days_until_expiry} day(s).</span>}
          {coi.state === 'expiring' && <span class="text-amber-700">Expires in {coi.days_until_expiry} day(s).</span>}
          {coi.state === 'expired' && <span class="text-red-700">Expired {Math.abs(coi.days_until_expiry ?? 0)} day(s) ago.</span>}
          {coi.state === 'missing' && <span class="text-gray-700">No COI on file.</span>}
        </p>
        <button type="submit" class="bg-[var(--color-brand)] text-white text-sm px-4 py-2 rounded-lg font-medium hover:bg-[var(--color-brand-dark)] transition">Save changes</button>
      </div>
    </form>

    <div>
      <h2 class="font-semibold text-lg mb-3">Work orders ({orders.length})</h2>
      <div class="border border-gray-200 rounded-xl overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="text-left px-4 py-3 font-semibold text-gray-700">Request</th>
              <th class="text-left px-4 py-3 font-semibold text-gray-700">Status</th>
              <th class="text-left px-4 py-3 font-semibold text-gray-700">Assigned</th>
              <th class="text-left px-4 py-3 font-semibold text-gray-700">Acknowledged</th>
              <th class="text-left px-4 py-3 font-semibold text-gray-700">Completed</th>
              <th class="text-left px-4 py-3 font-semibold text-gray-700">Cost</th>
            </tr>
          </thead>
          <tbody>
            {orders.length === 0 ? (
              <tr><td colspan="6" class="px-4 py-6 text-center text-gray-500">No work orders for this vendor.</td></tr>
            ) : orders.map((w) => (
              <tr class="border-b border-gray-100">
                <td class="px-4 py-3 font-mono text-xs text-gray-700">{w.maintenance_request_id}</td>
                <td class="px-4 py-3">
                  <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${statusPill[w.status] ?? ''}`}>{w.status.replace('_', ' ')}</span>
                </td>
                <td class="px-4 py-3 text-gray-600">{fmtTs(w.assigned_at)}</td>
                <td class="px-4 py-3 text-gray-600">{fmtTs(w.acknowledged_at)}</td>
                <td class="px-4 py-3 text-gray-600">{fmtTs(w.completed_at)}</td>
                <td class="px-4 py-3 text-gray-700">{w.cost_cents != null ? `$${(w.cost_cents / 100).toFixed(2)}` : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Base>
