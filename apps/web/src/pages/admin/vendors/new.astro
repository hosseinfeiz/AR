---
export const prerender = false
import Base from '../../../layouts/Base.astro'
import AdminNav from '../../../components/AdminNav.astro'
import { getSession } from '../../../lib/auth'
import { VENDOR_CATEGORIES, VENDOR_CATEGORY_LABELS } from '../../../lib/vendors'
import { buildings } from '../../../lib/fixtures'

const session = getSession(Astro.cookies)
if (!session || session.type !== 'admin') {
  return Astro.redirect('/login?redirect=/admin/vendors/new')
}
---
<Base title="Add vendor — Admin — A & R Management">
  <AdminNav />
  <div class="max-w-2xl mx-auto px-4 py-10">
    <p class="text-sm text-gray-500 mb-1">
      <a href="/admin" class="hover:underline">Admin</a> / <a href="/admin/vendors" class="hover:underline">Vendors</a> / New
    </p>
    <h1 class="text-3xl font-bold tracking-tight mb-6">Add vendor</h1>

    <form
      method="POST"
      action="/api/admin/vendors/create"
      class="border border-gray-200 rounded-xl p-6 space-y-5"
      enctype="application/x-www-form-urlencoded"
    >
      <label class="block">
        <span class="text-sm font-medium text-gray-700">Name</span>
        <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="name" required />
      </label>
      <label class="block">
        <span class="text-sm font-medium text-gray-700">Category</span>
        <select class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="category">
          {VENDOR_CATEGORIES.map((c) => (
            <option value={c}>{VENDOR_CATEGORY_LABELS[c]}</option>
          ))}
        </select>
      </label>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label class="block">
          <span class="text-sm font-medium text-gray-700">Contact name</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="contact_name" />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700">License number</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="license_number" />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700">Email</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="email" type="email" />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700">Phone</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="phone" />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700">Insurance expiry date</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="insurance_expiry_date" type="date" />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-gray-700">COI storage path</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="coi_storage_path" placeholder="vendor-coi/your-vendor-2026.pdf" />
        </label>
        <label class="block md:col-span-2">
          <span class="text-sm font-medium text-gray-700">Rating (0–5)</span>
          <input class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" name="rating" type="number" step="0.1" min="0" max="5" />
        </label>
      </div>

      <fieldset>
        <legend class="text-sm font-medium text-gray-700 mb-1">Buildings</legend>
        <div class="space-y-1">
          {buildings.map((b) => (
            <label class="flex items-center gap-2 text-sm">
              <input type="checkbox" name="building_ids" value={b.id} checked />
              {b.name}
            </label>
          ))}
        </div>
      </fieldset>

      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" name="active" value="true" checked />
        <span>Active</span>
      </label>

      <div class="flex items-center justify-end gap-3 pt-2 border-t border-gray-100">
        <a href="/admin/vendors" class="text-sm text-gray-500 hover:text-gray-800">Cancel</a>
        <button type="submit" class="bg-[var(--color-brand)] text-white text-sm px-4 py-2 rounded-lg font-medium hover:bg-[var(--color-brand-dark)] transition">Create vendor</button>
      </div>
    </form>
  </div>
</Base>
