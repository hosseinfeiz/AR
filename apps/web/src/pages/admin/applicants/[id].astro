---
export const prerender = false
import Base from '../../../layouts/Base.astro'
import AdminNav from '../../../components/AdminNav.astro'
import { getSession } from '../../../lib/auth'
import { getApplicant, allowedNextStatuses, type ApplicantStatus } from '../../../lib/applicants'
import { buildings, units } from '../../../lib/fixtures'

const session = getSession(Astro.cookies)
if (!session || session.type !== 'admin') {
  return Astro.redirect('/login?redirect=' + Astro.url.pathname)
}

const { id } = Astro.params
const applicant = id ? await getApplicant(id) : null
if (!applicant) {
  return Astro.redirect('/admin/applicants')
}

const building = buildings.find((b) => b.id === applicant.building_id)
const unit = applicant.unit_id ? units.find((u) => u.id === applicant.unit_id) : null

const next = allowedNextStatuses(applicant.status)

const STATUS_LABEL: Record<ApplicantStatus, string> = {
  inquiry: 'Inquiry',
  application: 'Application',
  screening: 'Screening',
  lease_ready: 'Lease ready',
  signed: 'Signed',
  withdrawn: 'Withdrawn',
}

const STATUS_PILL: Record<ApplicantStatus, string> = {
  inquiry: 'bg-slate-100 text-slate-700',
  application: 'bg-blue-100 text-blue-800',
  screening: 'bg-amber-100 text-amber-800',
  lease_ready: 'bg-violet-100 text-violet-800',
  signed: 'bg-green-100 text-green-800',
  withdrawn: 'bg-gray-100 text-gray-500',
}

function fmtMoney(cents: number | null): string {
  if (cents == null) return '—'
  return (cents / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' })
}

function fmtDate(iso: string | null): string {
  if (!iso) return '—'
  const d = iso.length === 10 ? new Date(iso + 'T00:00:00Z') : new Date(iso)
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
}
---
<Base title={`${applicant.name} — Applicant — A & R Management`}>
  <AdminNav />
  <div class="max-w-4xl mx-auto px-4 py-10 space-y-8">
    <!-- Breadcrumb -->
    <div>
      <p class="text-sm text-gray-500 mb-1">
        <a href="/admin" class="hover:underline">Admin</a> /
        <a href="/admin/applicants" class="hover:underline ml-1">Applicants</a> /
        <span class="ml-1">{applicant.name}</span>
      </p>
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">{applicant.name}</h1>
          <p class="text-gray-500">{applicant.email}{applicant.phone ? ` · ${applicant.phone}` : ''}</p>
        </div>
        <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${STATUS_PILL[applicant.status]}`}>
          {STATUS_LABEL[applicant.status]}
        </span>
      </div>
    </div>

    <!-- Quick facts -->
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="border border-gray-200 rounded-xl p-5">
        <h2 class="font-semibold mb-3">Target property</h2>
        <dl class="space-y-1.5 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Building</dt><dd class="font-medium">{building?.name ?? '—'}</dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Unit</dt><dd class="font-medium">{unit ? `#${unit.unit_number}` : '—'}</dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Move-in date</dt><dd class="font-medium">{fmtDate(applicant.move_in_date)}</dd></div>
          {unit && (
            <div class="flex justify-between"><dt class="text-gray-500">Listed rent</dt><dd class="font-medium">{fmtMoney(unit.monthly_rent_cents)}</dd></div>
          )}
        </dl>
      </div>
      <div class="border border-gray-200 rounded-xl p-5">
        <h2 class="font-semibold mb-3">Financials</h2>
        <dl class="space-y-1.5 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Monthly income</dt><dd class="font-bold text-base">{fmtMoney(applicant.monthly_income_cents)}</dd></div>
          {unit && applicant.monthly_income_cents && (
            <div class="flex justify-between">
              <dt class="text-gray-500">Income / rent ratio</dt>
              <dd class="font-medium">{(applicant.monthly_income_cents / unit.monthly_rent_cents).toFixed(2)}×</dd>
            </div>
          )}
          <div class="flex justify-between"><dt class="text-gray-500">Created</dt><dd>{fmtDate(applicant.created_at)}</dd></div>
        </dl>
      </div>
    </div>

    <!-- Screening -->
    <div class="border border-gray-200 rounded-xl p-5" data-section="screening">
      <div class="flex items-start justify-between mb-3">
        <h2 class="font-semibold">Screening</h2>
        {applicant.screening_score != null ? (
          <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${
            applicant.screening_recommendation === 'accept' ? 'bg-green-100 text-green-800'
            : applicant.screening_recommendation === 'decline' ? 'bg-red-100 text-red-800'
            : 'bg-amber-100 text-amber-800'
          }`}>
            {applicant.screening_recommendation ?? 'pending'}
          </span>
        ) : null}
      </div>
      {applicant.screening_score != null ? (
        <dl class="space-y-1.5 text-sm">
          <div class="flex justify-between"><dt class="text-gray-500">Provider ref</dt><dd class="font-mono text-xs">{applicant.screening_provider_ref}</dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Score</dt><dd class="font-bold">{applicant.screening_score}</dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Recommendation</dt><dd class="font-medium capitalize">{applicant.screening_recommendation}</dd></div>
        </dl>
      ) : (
        <p class="text-sm text-gray-500 mb-3">No screening on file yet.</p>
      )}
      {applicant.status === 'application' || applicant.status === 'screening' ? (
        <button id="run-screening" data-id={applicant.id} class="mt-3 inline-flex items-center bg-amber-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-amber-700 transition">
          {applicant.screening_score != null ? 'Re-run screening' : 'Run TransUnion screening'}
        </button>
      ) : null}
    </div>

    <!-- E-sign / Lease -->
    <div class="border border-gray-200 rounded-xl p-5" data-section="esign">
      <h2 class="font-semibold mb-3">Lease &amp; e-signature</h2>
      {applicant.esign_envelope_id ? (
        <dl class="space-y-1.5 text-sm mb-3">
          <div class="flex justify-between"><dt class="text-gray-500">Envelope id</dt><dd class="font-mono text-xs">{applicant.esign_envelope_id}</dd></div>
          <div class="flex justify-between"><dt class="text-gray-500">Status</dt><dd class="font-medium capitalize">{applicant.status === 'signed' ? 'Signed' : 'Awaiting signature'}</dd></div>
        </dl>
      ) : (
        <p class="text-sm text-gray-500 mb-3">No lease sent yet.</p>
      )}
      {applicant.status === 'screening' && applicant.screening_recommendation === 'accept' && !applicant.esign_envelope_id ? (
        <button id="send-lease" data-id={applicant.id} class="inline-flex items-center bg-violet-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-violet-700 transition">
          Generate &amp; send lease
        </button>
      ) : null}
      {applicant.status === 'lease_ready' && applicant.esign_envelope_id ? (
        <button id="simulate-sign" data-id={applicant.id} data-envelope={applicant.esign_envelope_id} class="inline-flex items-center bg-gray-700 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-800 transition">
          Simulate signed (mock)
        </button>
      ) : null}
    </div>

    <!-- Status actions -->
    {next.length > 0 && (
      <div class="border border-gray-200 rounded-xl p-5">
        <h2 class="font-semibold mb-3">Advance status</h2>
        <p class="text-sm text-gray-600 mb-3">
          Current: <strong>{STATUS_LABEL[applicant.status]}</strong>.
          Choose the next stage:
        </p>
        <div class="flex flex-wrap gap-2">
          {next.map((s) => (
            <button
              data-status={s}
              data-id={applicant.id}
              class="status-btn px-3 py-1.5 rounded-lg text-sm font-medium border border-gray-300 text-gray-700 hover:bg-gray-50"
            >
              → {STATUS_LABEL[s]}
            </button>
          ))}
        </div>
        <p id="status-error" class="text-sm text-red-600 mt-3 hidden"></p>
      </div>
    )}
  </div>

  <script>
    async function postJson(url: string, body: unknown) {
      const res = await fetch(url, {
        method: url.endsWith('/status') ? 'PATCH' : 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      })
      const json = await res.json().catch(() => ({}))
      return { ok: res.ok, status: res.status, json }
    }

    function showError(text: string) {
      const el = document.getElementById('status-error') as HTMLParagraphElement | null
      if (!el) { alert(text); return }
      el.textContent = text
      el.classList.remove('hidden')
    }

    document.querySelectorAll<HTMLButtonElement>('.status-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id!
        const status = btn.dataset.status!
        btn.disabled = true
        const { ok, json } = await postJson(`/api/admin/applicants/${id}/status`, { status })
        if (!ok) {
          showError((json as { error?: string }).error ?? 'Failed to change status')
          btn.disabled = false
          return
        }
        window.location.reload()
      })
    })

    document.getElementById('run-screening')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement
      const id = btn.dataset.id!
      btn.disabled = true
      btn.textContent = 'Running screening…'
      const { ok, json } = await postJson(`/api/admin/applicants/${id}/screen`, {})
      if (!ok) {
        showError((json as { error?: string }).error ?? 'Screening failed')
        btn.disabled = false
        return
      }
      window.location.reload()
    })

    document.getElementById('send-lease')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement
      const id = btn.dataset.id!
      btn.disabled = true
      btn.textContent = 'Generating lease…'
      const { ok, json } = await postJson(`/api/admin/applicants/${id}/send-lease`, {})
      if (!ok) {
        showError((json as { error?: string }).error ?? 'Failed to send lease')
        btn.disabled = false
        return
      }
      window.location.reload()
    })

    document.getElementById('simulate-sign')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement
      const id = btn.dataset.id!
      const envelope = btn.dataset.envelope!
      btn.disabled = true
      btn.textContent = 'Posting webhook…'
      const { ok, json } = await postJson(`/api/webhooks/esign`, {
        event_type: 'signature_request_all_signed',
        envelope_id: envelope,
        applicant_id: id,
      })
      if (!ok) {
        showError((json as { error?: string }).error ?? 'Webhook failed')
        btn.disabled = false
        return
      }
      window.location.reload()
    })
  </script>
</Base>
