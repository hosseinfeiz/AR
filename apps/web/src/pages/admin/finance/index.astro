---
export const prerender = false
import Base from '../../../layouts/Base.astro'
import AdminNav from '../../../components/AdminNav.astro'
import { getSession } from '../../../lib/auth'
import {
  getFinancialSummary,
  getMonthlyTotals,
  fmtCurrency,
  TODAY,
} from '../../../lib/finance-data'
import { expensesByCategory, EXPENSE_CATEGORY_LABELS } from '../../../lib/finance-fixtures'
import { buildings } from '../../../lib/fixtures'

const session = getSession(Astro.cookies)
if (!session || session.type !== 'admin') {
  return Astro.redirect('/login?redirect=/admin/finance')
}

// Date ranges
const thisMonthStart = '2026-05-01'
const thisMonthEnd = '2026-05-31'
const ytdStart = '2026-01-01'
const ytdEnd = TODAY

// Overall summaries
const thisMonth = getFinancialSummary({ from: thisMonthStart, to: thisMonthEnd })
const ytd = getFinancialSummary({ from: ytdStart, to: ytdEnd })

// Per-building
const GLM_ID = '11111111-1111-1111-1111-111111111111'
const WM_ID = '22222222-2222-2222-2222-222222222222'

const glmMonth = getFinancialSummary({ from: thisMonthStart, to: thisMonthEnd, building_id: GLM_ID })
const glmYtd = getFinancialSummary({ from: ytdStart, to: ytdEnd, building_id: GLM_ID })
const wmMonth = getFinancialSummary({ from: thisMonthStart, to: thisMonthEnd, building_id: WM_ID })
const wmYtd = getFinancialSummary({ from: ytdStart, to: ytdEnd, building_id: WM_ID })

// Monthly chart — last 12 months
const chartEnd = TODAY
const chartStartDate = new Date('2025-05-01T00:00:00Z')
const chartStart = chartStartDate.toISOString().slice(0, 10)
const monthlyData = getMonthlyTotals({ from: chartStart, to: chartEnd })

// Max income for relative bar sizing
const maxIncome = Math.max(...monthlyData.map((m) => m.income_cents), 1)
const maxExpense = Math.max(...monthlyData.map((m) => m.expense_cents), 1)
const barMax = Math.max(maxIncome, maxExpense, 1)

// Top 5 expense categories YTD
const ytdCats = expensesByCategory({ from: ytdStart, to: ytdEnd })
const sortedCats = Object.entries(ytdCats)
  .filter(([, v]) => v > 0)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 5)

function noi(cents: number): string {
  const val = cents / 100
  if (val >= 0) return `+${fmtCurrency(cents)}`
  return fmtCurrency(cents)
}

function noiClass(cents: number): string {
  return cents >= 0 ? 'text-green-700' : 'text-red-600'
}

function monthLabel(m: string): string {
  const [y, mo] = m.split('-')
  const d = new Date(Date.UTC(Number(y), Number(mo) - 1, 1))
  return d.toLocaleString('en-US', { month: 'short', timeZone: 'UTC' })
}
---
<Base title="Finance Overview — Admin — AR Management">
  <AdminNav />
  <div class="max-w-5xl mx-auto px-4 py-8 print:py-4">
    <div class="flex items-center justify-between mb-6">
      <div>
        <p class="text-sm text-gray-500 mb-1"><a href="/admin" class="hover:underline">Admin</a> / Finance</p>
        <h1 class="text-2xl font-bold tracking-tight">Finance Overview</h1>
        <p class="text-sm text-gray-500 mt-0.5">Reference date: May 4, 2026</p>
      </div>
    </div>

    <!-- 4-card metrics row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="border border-gray-200 rounded-xl p-5 bg-white">
        <p class="text-xs text-gray-500 uppercase tracking-wide font-medium">Income (this month)</p>
        <p class="text-2xl font-bold mt-1 text-gray-900">{fmtCurrency(thisMonth.income_cents)}</p>
        <p class="text-xs text-gray-400 mt-1">May 2026</p>
      </div>
      <div class="border border-gray-200 rounded-xl p-5 bg-white">
        <p class="text-xs text-gray-500 uppercase tracking-wide font-medium">Expenses (this month)</p>
        <p class="text-2xl font-bold mt-1 text-gray-900">{fmtCurrency(thisMonth.expense_cents)}</p>
        <p class="text-xs text-gray-400 mt-1">May 2026</p>
      </div>
      <div class="border border-gray-200 rounded-xl p-5 bg-white">
        <p class="text-xs text-gray-500 uppercase tracking-wide font-medium">NOI (this month)</p>
        <p class={`text-2xl font-bold mt-1 ${noiClass(thisMonth.noi_cents)}`}>{noi(thisMonth.noi_cents)}</p>
        <p class="text-xs text-gray-400 mt-1">May 2026</p>
      </div>
      <div class="border border-gray-200 rounded-xl p-5 bg-white">
        <p class="text-xs text-gray-500 uppercase tracking-wide font-medium">NOI (YTD)</p>
        <p class={`text-2xl font-bold mt-1 ${noiClass(ytd.noi_cents)}`}>{noi(ytd.noi_cents)}</p>
        <p class="text-xs text-gray-400 mt-1">Jan 1 – May 4, 2026</p>
      </div>
    </div>

    <!-- Per-building breakdown -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
      {[
        { building: buildings.find(b => b.id === GLM_ID)!, month: glmMonth, ytd: glmYtd },
        { building: buildings.find(b => b.id === WM_ID)!, month: wmMonth, ytd: wmYtd },
      ].map(({ building, month, ytd: bYtd }) => (
        <div class="border border-gray-200 rounded-xl p-5 bg-white">
          <h2 class="font-semibold text-gray-900 mb-3">{building.name}</h2>
          <div class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wide font-medium mb-1">This month</p>
              <p class="text-gray-700">Income: <span class="font-medium">{fmtCurrency(month.income_cents)}</span></p>
              <p class="text-gray-700">Expenses: <span class="font-medium">{fmtCurrency(month.expense_cents)}</span></p>
              <p class={`font-semibold ${noiClass(month.noi_cents)}`}>NOI: {noi(month.noi_cents)}</p>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wide font-medium mb-1">YTD 2026</p>
              <p class="text-gray-700">Income: <span class="font-medium">{fmtCurrency(bYtd.income_cents)}</span></p>
              <p class="text-gray-700">Expenses: <span class="font-medium">{fmtCurrency(bYtd.expense_cents)}</span></p>
              <p class={`font-semibold ${noiClass(bYtd.noi_cents)}`}>NOI: {noi(bYtd.noi_cents)}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Month-over-month chart (last 12 months) -->
    <div class="border border-gray-200 rounded-xl p-5 bg-white mb-8">
      <h2 class="font-semibold text-gray-900 mb-4">Income vs. Expenses — last 12 months</h2>
      <div class="flex items-end gap-1.5 h-36 overflow-x-auto">
        {monthlyData.map((m) => {
          const incomePct = Math.round((m.income_cents / barMax) * 100)
          const expPct = Math.round((m.expense_cents / barMax) * 100)
          const label = monthLabel(m.month)
          return (
            <div class="flex flex-col items-center gap-0.5 min-w-[2.5rem] flex-1">
              <!-- bars side by side -->
              <div class="flex items-end gap-0.5 w-full h-28">
                <div
                  class="flex-1 bg-[var(--color-brand)] rounded-t opacity-80 hover:opacity-100 transition-opacity cursor-default"
                  style={`height:${Math.max(incomePct, 2)}%`}
                  title={`${m.month} Income: ${fmtCurrency(m.income_cents)}`}
                ></div>
                <div
                  class="flex-1 bg-amber-400 rounded-t opacity-80 hover:opacity-100 transition-opacity cursor-default"
                  style={`height:${Math.max(expPct, 2)}%`}
                  title={`${m.month} Expenses: ${fmtCurrency(m.expense_cents)}`}
                ></div>
              </div>
              <span class="text-[9px] text-gray-400 text-center leading-tight">{label}</span>
            </div>
          )
        })}
      </div>
      <div class="flex items-center gap-4 mt-3 text-xs text-gray-500">
        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-sm bg-[var(--color-brand)] inline-block opacity-80"></span> Income</span>
        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-sm bg-amber-400 inline-block opacity-80"></span> Expenses</span>
        <span class="ml-auto text-gray-400">Hover bars for values</span>
      </div>
    </div>

    <!-- Top expense categories YTD -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="border border-gray-200 rounded-xl p-5 bg-white md:col-span-2">
        <h2 class="font-semibold text-gray-900 mb-3">Top expense categories — YTD 2026</h2>
        <ul class="space-y-3">
          {sortedCats.map(([cat, amount]) => {
            const total = Object.values(ytdCats).reduce((s, v) => s + v, 0) || 1
            const pct = Math.round((amount / total) * 100)
            return (
              <li class="flex items-center gap-3">
                <div class="w-32 text-xs text-gray-600 shrink-0">{EXPENSE_CATEGORY_LABELS[cat as keyof typeof EXPENSE_CATEGORY_LABELS]}</div>
                <div class="flex-1 bg-gray-100 rounded-full h-2">
                  <div class="bg-amber-400 h-2 rounded-full" style={`width:${pct}%`}></div>
                </div>
                <div class="w-20 text-right text-sm font-medium text-gray-800">{fmtCurrency(amount)}</div>
              </li>
            )
          })}
        </ul>
      </div>

      <!-- Quick links -->
      <div class="border border-gray-200 rounded-xl p-5 bg-white">
        <h2 class="font-semibold text-gray-900 mb-3">Quick links</h2>
        <div class="flex flex-col gap-2">
          <a href="/admin/finance/income" class="text-sm text-[var(--color-brand)] hover:underline">→ Income &amp; payments</a>
          <a href="/admin/finance/expenses" class="text-sm text-[var(--color-brand)] hover:underline">→ Expenses</a>
          <a href="/admin/finance/reports" class="text-sm text-[var(--color-brand)] hover:underline">→ Schedule E / P&amp;L report</a>
          <a href="/admin/finance/tax" class="text-sm text-[var(--color-brand)] hover:underline">→ Tax / 1099 tracking</a>
        </div>
      </div>
    </div>
  </div>
</Base>
