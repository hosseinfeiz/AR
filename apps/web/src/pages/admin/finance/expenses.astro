---
export const prerender = false
import Base from '../../../layouts/Base.astro'
import AdminNav from '../../../components/AdminNav.astro'
import AddExpenseToggle from '../../../components/islands/AddExpenseForm'
import { getSession } from '../../../lib/auth'
import {
  listExpenses,
  vendors,
  findVendorById,
  EXPENSE_CATEGORY_LABELS,
  type ExpenseCategory,
} from '../../../lib/finance-fixtures'
import { fmtCurrency, fmtDate } from '../../../lib/finance-data'
import { buildings } from '../../../lib/fixtures'

const session = getSession(Astro.cookies)
if (!session || session.type !== 'admin') {
  return Astro.redirect('/login?redirect=/admin/finance/expenses')
}

const url = new URL(Astro.request.url)
const filterBuilding = url.searchParams.get('building') ?? ''
const filterCategory = (url.searchParams.get('category') ?? '') as ExpenseCategory | ''
const filterFrom = url.searchParams.get('from') ?? ''
const filterTo = url.searchParams.get('to') ?? ''

const filtered = listExpenses({
  building_id: filterBuilding || undefined,
  from: filterFrom || undefined,
  to: filterTo || undefined,
  category: filterCategory || undefined,
})

// Sort by date desc
const rows = [...filtered].sort((a, b) => b.expense_date.localeCompare(a.expense_date))

const totalCents = rows.reduce((s, e) => s + e.amount_cents, 0)

const categories = Object.keys(EXPENSE_CATEGORY_LABELS) as ExpenseCategory[]

// Build CSV URL
const csvParams = new URLSearchParams()
if (filterBuilding) csvParams.set('building', filterBuilding)
if (filterCategory) csvParams.set('category', filterCategory)
if (filterFrom) csvParams.set('from', filterFrom)
if (filterTo) csvParams.set('to', filterTo)
const csvUrl = `/admin/finance/expenses.csv?${csvParams.toString()}`

// Vendor data for AddExpenseForm
const vendorList = vendors.map((v) => ({ id: v.id, name: v.name }))

function statusPill(s: string): string {
  if (s === 'paid') return 'bg-green-100 text-green-800'
  return 'bg-amber-100 text-amber-800'
}
---
<Base title="Expenses — Finance — Admin — AR Management">
  <AdminNav />
  <div class="max-w-5xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <p class="text-sm text-gray-500 mb-1">
          <a href="/admin" class="hover:underline">Admin</a> /
          <a href="/admin/finance" class="hover:underline">Finance</a> / Expenses
        </p>
        <h1 class="text-2xl font-bold tracking-tight">Expenses</h1>
      </div>
      <a
        href={csvUrl}
        class="inline-flex items-center gap-1.5 border border-gray-300 text-gray-700 px-3 py-1.5 rounded-lg text-sm hover:border-gray-400 transition"
      >
        ↓ Download CSV
      </a>
    </div>

    <!-- Add Expense island -->
    <AddExpenseToggle client:load vendors={vendorList} />

    <!-- Filters -->
    <div class="border border-gray-200 rounded-xl p-4 mb-6 bg-white mt-4">
      <form method="get" class="flex flex-wrap gap-3 items-end">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Building</label>
          <select name="building" class="text-sm border border-gray-300 rounded px-2 py-1.5 bg-white">
            <option value="">All buildings</option>
            {buildings.map((b) => (
              <option value={b.id} selected={filterBuilding === b.id}>{b.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Category</label>
          <select name="category" class="text-sm border border-gray-300 rounded px-2 py-1.5 bg-white">
            <option value="">All categories</option>
            {categories.map((c) => (
              <option value={c} selected={filterCategory === c}>{EXPENSE_CATEGORY_LABELS[c]}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">From</label>
          <input type="date" name="from" value={filterFrom} class="text-sm border border-gray-300 rounded px-2 py-1.5" />
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">To</label>
          <input type="date" name="to" value={filterTo} class="text-sm border border-gray-300 rounded px-2 py-1.5" />
        </div>
        <div class="flex gap-2">
          <button type="submit" class="bg-[var(--color-brand)] text-white px-3 py-1.5 rounded text-sm font-medium hover:bg-[var(--color-brand-dark)]">
            Filter
          </button>
          <a href="/admin/finance/expenses" class="border border-gray-300 text-gray-700 px-3 py-1.5 rounded text-sm hover:border-gray-400">
            Clear
          </a>
        </div>
      </form>
    </div>

    <!-- Expenses table -->
    <div class="border border-gray-200 rounded-xl overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200">
            <th class="text-left px-4 py-3 font-semibold text-gray-700">Date</th>
            <th class="text-left px-4 py-3 font-semibold text-gray-700">Building</th>
            <th class="text-left px-4 py-3 font-semibold text-gray-700">Category</th>
            <th class="text-left px-4 py-3 font-semibold text-gray-700">Vendor</th>
            <th class="text-right px-4 py-3 font-semibold text-gray-700">Amount</th>
            <th class="text-center px-4 py-3 font-semibold text-gray-700">Status</th>
            <th class="text-left px-4 py-3 font-semibold text-gray-700">Method</th>
            <th class="text-left px-4 py-3 font-semibold text-gray-700">Description</th>
          </tr>
        </thead>
        <tbody>
          {rows.length === 0 && (
            <tr>
              <td colspan="8" class="px-4 py-8 text-center text-gray-400">No expenses match the selected filters.</td>
            </tr>
          )}
          {rows.map((e) => {
            const building = buildings.find((b) => b.id === e.building_id)
            const buildingShort = building?.name.includes('Grass') ? 'GLM' : 'WM'
            const vendor = e.vendor_id ? findVendorById(e.vendor_id) : null
            return (
              <tr class="border-b border-gray-100 hover:bg-gray-50 transition">
                <td class="px-4 py-3 text-gray-600 whitespace-nowrap">{fmtDate(e.expense_date)}</td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700">{buildingShort}</span>
                </td>
                <td class="px-4 py-3 text-gray-700">{EXPENSE_CATEGORY_LABELS[e.category]}</td>
                <td class="px-4 py-3 text-gray-600 text-xs">{vendor ? vendor.name : <span class="text-gray-400">—</span>}</td>
                <td class="px-4 py-3 text-right font-medium">{fmtCurrency(e.amount_cents)}</td>
                <td class="px-4 py-3 text-center">
                  <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${statusPill(e.status)}`}>
                    {e.status === 'paid' ? 'Paid' : 'Pending'}
                  </span>
                </td>
                <td class="px-4 py-3 text-gray-600">{e.payment_method.toUpperCase()}</td>
                <td class="px-4 py-3 text-gray-600 max-w-xs truncate" title={e.description}>{e.description}</td>
              </tr>
            )
          })}
        </tbody>
        {rows.length > 0 && (
          <tfoot>
            <tr class="bg-gray-50">
              <td class="px-4 py-3 font-semibold" colspan="4">
                {rows.length} expense{rows.length !== 1 ? 's' : ''}
              </td>
              <td class="px-4 py-3 text-right font-bold">{fmtCurrency(totalCents)}</td>
              <td colspan="3"></td>
            </tr>
          </tfoot>
        )}
      </table>
    </div>
  </div>
</Base>
