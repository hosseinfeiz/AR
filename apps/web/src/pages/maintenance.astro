---
export const prerender = false
import Base from '../layouts/Base.astro'
import { MaintenanceForm } from '../components/islands/MaintenanceForm'
import { listBuildings } from '../lib/data'
import { isMockMode } from '../lib/fixtures'
import { clientEnv } from '../lib/env'

const allBuildings = await listBuildings()
const buildings: { id: string; name: string }[] = allBuildings.map((b) => ({ id: b.id, name: b.name }))
const mock = isMockMode()
---
<Base title="Submit a maintenance request" description="Tell us about a maintenance issue at your A & R Management apartment.">
  <section class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold">Maintenance request</h1>
    <p class="mt-2 text-gray-600">Existing residents — let us know what needs attention. We'll route your request to your building's property manager and copy the A & R Management office.</p>
    {mock && (
      <p class="mt-3 text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded px-3 py-2">
        Dev mock mode: requests are accepted and logged on the server, but emails are only sent when RESEND_API_KEY is configured.
      </p>
    )}
    <div class="mt-6">
      <MaintenanceForm
        client:load
        supabaseUrl={clientEnv.VITE_SUPABASE_URL}
        anonKey={clientEnv.VITE_SUPABASE_ANON_KEY}
        turnstileSiteKey={clientEnv.VITE_TURNSTILE_SITE_KEY}
        buildings={buildings}
        mockMode={mock}
      />
    </div>
  </section>
</Base>
