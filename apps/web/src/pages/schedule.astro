---
export const prerender = false
import Base from '../layouts/Base.astro'
import { ShowingForm } from '../components/islands/ShowingForm'
import { listBuildings, getUnitById } from '../lib/data'
import { isMockMode } from '../lib/fixtures'
import { clientEnv } from '../lib/env'

const unitId = Astro.url.searchParams.get('unit')
const allBuildings = await listBuildings()
const buildings: { id: string; name: string }[] = allBuildings.map((b) => ({ id: b.id, name: b.name }))

let initialBuildingId: string | null = null
if (unitId) {
  const u = await getUnitById(unitId)
  initialBuildingId = u?.building_id ?? null
}
const mock = isMockMode()
---
<Base title="Schedule a showing" description="Pick a tour time at Grass Lake Manor or Winnetka Manor.">
  <section class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold">Book a showing</h1>
    <p class="mt-2 text-gray-600">Pick an open slot — we'll confirm it instantly and email you a calendar invite.</p>
    {mock && (
      <p class="mt-3 text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded px-3 py-2">
        Dev mock mode: form submissions are simulated (no real Supabase configured).
      </p>
    )}
    <div class="mt-6">
      <ShowingForm
        client:load
        supabaseUrl={clientEnv.VITE_SUPABASE_URL}
        anonKey={clientEnv.VITE_SUPABASE_ANON_KEY}
        turnstileSiteKey={clientEnv.VITE_TURNSTILE_SITE_KEY}
        buildings={buildings}
        initialUnitId={unitId}
        initialBuildingId={initialBuildingId}
        mockMode={mock}
      />
    </div>
  </section>
</Base>
